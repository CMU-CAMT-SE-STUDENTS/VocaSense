# Docker Compose host ports (optional; these defaults are suitable for local use).
FRONTEND_PORT=8080
BACKEND_PORT=8000

# Frontend build-time configuration. Public values are embedded in browser assets.
# Required: copy the project URL and publishable key from Supabase > Project Settings > API.
# A Supabase publishable/anon key is designed to be public; protect data with RLS.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Optional: leave blank to use the same-origin /api reverse proxy in Nginx.
VITE_API_BASE_URL=

# Backend runtime configuration. SUPABASE_URL is public project configuration.
# Required for database-backed features. Obtain the URL from Supabase Project Settings > API.
SUPABASE_URL=https://your-project.supabase.co
# Required server-side secret. Obtain the secret key from Supabase Project Settings > API Keys.
# Never expose this key through a VITE_ variable or browser build argument.
SUPABASE_SECRET_KEY=replace-with-supabase-secret-key
# Optional legacy alternative to SUPABASE_SECRET_KEY (do not set both unless intentional).
# SUPABASE_SERVICE_ROLE_KEY=replace-with-legacy-service-role-key

# Optional sensitive credential. Create a key in Google AI Studio to enable AI wording;
# deterministic recommendations continue to work when this is empty.
GEMINI_API_KEY=
# Optional public model selection; defaults to gemini-3.5-flash-lite in the backend.
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional comma-separated browser origins for direct cross-origin API access.
# The bundled frontend uses the same-origin Nginx proxy by default.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production Compose only: optional image tag to pull (default: latest).
IMAGE_TAG=latest
