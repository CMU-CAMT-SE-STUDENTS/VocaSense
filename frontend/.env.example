# Copy this file to .env and fill in the values (do not commit .env).
# Supabase project URL and publishable (anon) key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Backend API base URL. Defaults to http://localhost:8000 when not set.
# In production, set this to the Render backend URL.
VITE_API_BASE_URL=http://localhost:8000
